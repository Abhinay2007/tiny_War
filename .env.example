# Core app starts without service variables. Set this to your Tiny Aya Space
# identifier (owner/space) or URL to enable AI hero/text generation.

HF_TOKEN=

# Optional hosted model services; leave blank to keep these features disabled.
TINY_VOXCPM_SPACE=
TINY_ACESTEP_SPACE=
TINY_MINICPM5_SPACE=
TINY_MELLUM_SPACE=
TINY_BLS_CODE_SPACE=

# Optional external API providers. Never put keys in source files.
NVIDIA_NIM_API_KEY=
DASHSCOPE_API_KEY=

# Optional Tiny Army local/external llama.cpp fallback for personas and diaries.
# When TINY_LLM_BASE_URL is blank, the app may download its default GGUF on first
# persona/diary use. Set a compatible server URL to avoid an in-container download.
TINY_LLM_BASE_URL=
TINY_LLM_API_KEY=
# TINY_LLM_MODEL_PATH=
# TINY_LLM_HF_REPO=Qwen/Qwen2.5-0.5B-Instruct-GGUF
# TINY_LLM_HF_FILE=*q4_k_m.gguf
# TINY_LLM_N_CTX=2048
# TINY_LLM_N_THREADS=2

# Optional local model modes are not installed in the core image and require their
# own model dependencies/hardware. Leave unset for the portable Docker setup.
# TINY_TTS_MODE=local
# TINY_IMAGE_MODE=local

# Docker Compose host port. The app always listens on port 7860 inside the container.
TINY_ARMY_HOST_PORT=7860

# Local default. Render supplies PORT automatically; normally do not set it there.
PORT=7860
